{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "vite.config.ts",
    "drizzle.config.ts",
    "tailwind.config.ts",
    "vitest.config.ts"
  ]
}
