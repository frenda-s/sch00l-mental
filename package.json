{
  "name": "school-mental-health",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hệ thống website hỗ trợ sàng lọc và tư vấn tâm lý học đường THPT",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,client\" -c \"magenta,cyan\" \"npm run dev:api\" \"vite\"",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.node.json",
    "worker:dev": "wrangler dev",
    "dev:api": "tsx watch src/server/local.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:clean": "tsx src/server/db/clean.ts",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/server/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.5",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@hono/node-server": "^1.13.7",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "marked": "^18.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "wrangler": "^3.99.0"
  }
}
